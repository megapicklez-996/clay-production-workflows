{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchidautomation.example/schemas/clay-reconciliation-envelope.json",
  "title": "Clay workflow reconciliation envelope",
  "type": "object",
  "required": [
    "workflow_id",
    "campaign_key",
    "config_hash",
    "stable_identity_hash",
    "terminal_outcome",
    "reconciliation_required"
  ],
  "properties": {
    "workflow_id": {"type": "string", "pattern": "^wf_"},
    "workflow_snapshot_id": {"type": ["string", "null"]},
    "run_id": {"type": ["string", "null"]},
    "campaign_key": {"type": "string", "minLength": 1},
    "campaign_version": {"type": ["string", "null"]},
    "config_hash": {"type": "string", "minLength": 1},
    "ai_context_hash": {"type": ["string", "null"]},
    "stable_identity_hash": {"type": "string", "minLength": 1},
    "eligibility_status": {"type": ["string", "null"]},
    "suppression_status": {"type": ["string", "null"]},
    "approval_references": {"type": "object"},
    "intended_destinations": {"type": "object"},
    "external_receipts": {"type": "object"},
    "readbacks": {"type": "object"},
    "credits_spent": {"type": ["number", "null"], "minimum": 0},
    "terminal_outcome": {
      "enum": [
        "activated_verified",
        "already_satisfied",
        "review_only",
        "safely_suppressed",
        "provider_failure",
        "destination_rejection",
        "reconciliation_failure"
      ]
    },
    "stop_reason": {"type": ["string", "null"]},
    "reconciliation_required": {"type": "boolean"},
    "reconciliation_owner": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
